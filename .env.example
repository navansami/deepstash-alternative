# Copy to .env.local (git-ignored) and fill in. Set the same values in Vercel → Settings → Environment Variables.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (optional, defaults to "kernel")
MONGODB_DB=kernel
# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Comma-separated extra browser origins allowed to call the API (local Flutter web dev is always allowed)
CORS_ORIGINS=
