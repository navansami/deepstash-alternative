{
  "name": "kernel-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env.local server/dev.ts",
    "seed": "tsx --env-file=.env.local server/scripts/seed.ts",
    "make-admin": "tsx --env-file=.env.local server/scripts/make-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.22",
    "jose": "^5.10.0",
    "mongodb": "^6.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.19",
    "@types/node": "^22.20.5",
    "mongodb-memory-server": "^10.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  }
}
